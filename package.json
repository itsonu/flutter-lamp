{
  "name": "flutter-lamp",
  "version": "0.5.0",
  "description": "Flutter Lamp — an MCP server giving AI live eyes on a running Flutter app over the Dart VM Service: exceptions, logs, network, frames, memory + root-cause diagnosis.",
  "type": "module",
  "license": "MIT",
  "author": "Chandrabhushan Prakash",
  "homepage": "https://github.com/itsonu/flutter-lamp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsonu/flutter-lamp.git"
  },
  "bugs": {
    "url": "https://github.com/itsonu/flutter-lamp/issues"
  },
  "keywords": [
    "flutter",
    "dart",
    "mcp",
    "model-context-protocol",
    "vm-service",
    "observability",
    "debugging",
    "devtools",
    "claude",
    "ai"
  ],
  "bin": {
    "flutter-lamp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "dashboard",
    "docs",
    ".claude/skills",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test --test-force-exit \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
