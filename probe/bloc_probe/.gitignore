/android/app/debug
/android/app/profile
/android/app/release

# Windows desktop target. The runner sources are checked in so the incidental
# scenario can be reproduced over loopback; flutter/ephemeral is ~300 MB of
# engine artifacts regenerated by any build.
/windows/flutter/ephemeral/
